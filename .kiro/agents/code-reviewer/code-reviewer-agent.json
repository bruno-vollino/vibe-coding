{
  "name": "code-review-agent",
  "description": "Code review and quality analysis. Reads Jira, GitLab MRs and CI logs, reviews the diff, and posts diff-anchored review comments via the gitlab-diff-comments skill.",
  "prompt": "file://./code-reviewer-prompt.md",
  "tools": [
    "read",
    "shell",
    "fs_read",
    "fs_write",
    "@git",
    "@gitlab-entain",
    "@atlassian-mcp-server",
    "@fetch",
    "@intellij-mpc-server/read_file",
    "@intellij-mpc-server/list_directory_tree",
    "@intellij-mpc-server/search_symbol",
    "@intellij-mpc-server/search_regex",
    "@intellij-mpc-server/search_file",
    "@intellij-mpc-server/get_symbol_info",
    "@intellij-mpc-server/get_project_modules",
    "@intellij-mpc-server/get_project_dependencies",
    "@intellij-mpc-server/get_file_problems",
    "@intellij-mpc-server/get_run_configurations",
    "@intellij-mpc-server/get_repositories",
    "@intellij-mpc-server/git_status",
    "@intellij-mpc-server/lint_files",
    "@intellij-mpc-server/build_project",
    "@intellij-mpc-server/execute_run_configuration"
  ],
  "allowedTools": [
    "read",
    "fs_read",
    "@git/git_status",
    "@git/git_log",
    "@git/git_show",
    "@git/git_diff",
    "@git/git_diff_staged",
    "@git/git_diff_unstaged",
    "@git/git_branch",
    "@gitlab-entain/get_*",
    "@gitlab-entain/list_*",
    "@gitlab-entain/*search*",
    "@atlassian-mcp-server/get*",
    "@atlassian-mcp-server/search*",
    "@atlassian-mcp-server/lookup*",
    "@atlassian-mcp-server/fetch",
    "@atlassian-mcp-server/atlassianUserInfo",
    "@intellij-mpc-server/read_file",
    "@intellij-mpc-server/list_directory_tree",
    "@intellij-mpc-server/search_*",
    "@intellij-mpc-server/get_*",
    "@intellij-mpc-server/git_status",
    "@intellij-mpc-server/lint_files",
    "@intellij-mpc-server/build_project",
    "@intellij-mpc-server/execute_run_configuration",
    "@fetch/fetch"
  ],
  "permissions": {
    "rules": [
      {
        "capability": "shell",
        "match": [
          "git --version",
          "git status*",
          "git log*",
          "git show *",
          "git diff*",
          "git branch*",
          "git blame *",
          "git rev-parse *",
          "git merge-base *",
          "git ls-remote *",
          "git ls-files *",
          "git cat-file *",
          "git fetch *",
          "git -C * status*",
          "git -C * log*",
          "git -C * show *",
          "git -C * diff*",
          "git -C * branch*",
          "git -C * blame *",
          "git -C * rev-parse *",
          "git -C * merge-base *",
          "git -C * ls-remote *",
          "git -C * ls-files *",
          "git -C * cat-file *",
          "git -C * fetch *",
          "glab api --method GET *",
          "glab auth status*",
          "glab --version",
          "python --version",
          "python3 --version",
          "python *gitlab_diff_comments.py anchors *",
          "python3 *gitlab_diff_comments.py anchors *",
          "python *gitlab_diff_comments.py post *",
          "python3 *gitlab_diff_comments.py post *",
          "python *git_pull.py *",
          "python3 *git_pull.py *"
        ],
        "effect": "allow"
      },
      {
        "capability": "shell",
        "match": ["*"],
        "exclude": [
          "git --version",
          "git status*",
          "git log*",
          "git show *",
          "git diff*",
          "git branch*",
          "git blame *",
          "git rev-parse *",
          "git merge-base *",
          "git ls-remote *",
          "git ls-files *",
          "git cat-file *",
          "git fetch *",
          "git -C * status*",
          "git -C * log*",
          "git -C * show *",
          "git -C * diff*",
          "git -C * branch*",
          "git -C * blame *",
          "git -C * rev-parse *",
          "git -C * merge-base *",
          "git -C * ls-remote *",
          "git -C * ls-files *",
          "git -C * cat-file *",
          "git -C * fetch *",
          "glab api --method GET *",
          "glab auth status*",
          "glab --version",
          "python --version",
          "python3 --version",
          "python *gitlab_diff_comments.py anchors *",
          "python3 *gitlab_diff_comments.py anchors *",
          "python *gitlab_diff_comments.py post *",
          "python3 *gitlab_diff_comments.py post *",
          "python *git_pull.py *",
          "python3 *git_pull.py *"
        ],
        "effect": "deny"
      },
      {
        "capability": "fs_read",
        "match": ["**"],
        "effect": "allow"
      },
      {
        "capability": "fs_write",
        "match": ["**/.review/**"],
        "effect": "allow"
      },
      {
        "capability": "fs_write",
        "match": ["**"],
        "exclude": ["**/.review/**"],
        "effect": "deny"
      },
      {
        "capability": "skill",
        "match": ["*"],
        "effect": "allow"
      },
      {
        "capability": "context",
        "match": ["*"],
        "effect": "allow"
      },
      {
        "capability": "mcp",
        "match": [
          "git/git_status",
          "git/git_log",
          "git/git_show",
          "git/git_diff*",
          "git/git_branch",
          "gitlab-entain/get_*",
          "gitlab-entain/list_*",
          "gitlab-entain/*search*",
          "atlassian-mcp-server/get*",
          "atlassian-mcp-server/search*",
          "atlassian-mcp-server/lookup*",
          "atlassian-mcp-server/fetch",
          "atlassian-mcp-server/atlassianUserInfo",
          "intellij-mpc-server/read_file",
          "intellij-mpc-server/list_directory_tree",
          "intellij-mpc-server/search_*",
          "intellij-mpc-server/get_*",
          "intellij-mpc-server/git_status",
          "intellij-mpc-server/lint_files",
          "intellij-mpc-server/build_project",
          "intellij-mpc-server/execute_run_configuration",
          "fetch/fetch"
        ],
        "effect": "allow"
      },
      {
        "capability": "mcp",
        "match": ["*"],
        "exclude": [
          "git/git_status",
          "git/git_log",
          "git/git_show",
          "git/git_diff*",
          "git/git_branch",
          "gitlab-entain/get_*",
          "gitlab-entain/list_*",
          "gitlab-entain/*search*",
          "atlassian-mcp-server/get*",
          "atlassian-mcp-server/search*",
          "atlassian-mcp-server/lookup*",
          "atlassian-mcp-server/fetch",
          "atlassian-mcp-server/atlassianUserInfo",
          "intellij-mpc-server/read_file",
          "intellij-mpc-server/list_directory_tree",
          "intellij-mpc-server/search_*",
          "intellij-mpc-server/get_*",
          "intellij-mpc-server/git_status",
          "intellij-mpc-server/lint_files",
          "intellij-mpc-server/build_project",
          "intellij-mpc-server/execute_run_configuration",
          "fetch/fetch"
        ],
        "effect": "deny"
      }
    ]
  },
  "resources": [],
  "includeMcpJson": true,
  "model": "claude-opus-5",
  "welcomeMessage": "Tell me which Gitlab MR and Jira issue/task I should review"
}
